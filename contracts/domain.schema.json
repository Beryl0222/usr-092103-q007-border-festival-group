{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "边境节庆团组协同领域事件",
  "description": "跨模块交换的公共信封与稳定枚举。各事件的 payload 载荷约定见 docs/event-catalog.md 与 src/domain/catalog.js。",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "GROUP_CREATED",
        "GROUP_UPDATED",
        "LEADER_ASSIGNED",
        "TEAM_DEFINED",
        "MEMBER_REGISTERED",
        "MEMBER_PROFILE_UPDATED",
        "MEMBER_WITHDRAWN",
        "NAME_DISAMBIGUATED",
        "ELIGIBILITY_REQUESTED",
        "ELIGIBILITY_CONFIRMED",
        "ELIGIBILITY_DENIED",
        "RESOURCE_DEFINED",
        "RESOURCE_HELD",
        "WAITLIST_JOINED",
        "WAITLIST_PROMOTED",
        "HOLD_RELEASED",
        "BOOKING_CREATED",
        "BOOKING_MEMBER_ATTACHED",
        "BOOKING_MEMBER_DETACHED",
        "BOOKING_CANCELLED",
        "CROSSING_SLOT_DEFINED",
        "CROSSING_CAPACITY_CHANGED",
        "CROSSING_ASSIGNED",
        "CROSSING_BATCH_PROPOSED",
        "CROSSING_RESCHEDULED",
        "CONTRACT_AGREED",
        "ATTENDANCE_RECORDED",
        "ATTENDANCE_SETTLED",
        "CANCELLATION_LIABILITY_DECIDED",
        "EXPORT_ISSUED",
        "EXPORT_REVOKED",
        "AUDIT_RECORDED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "travel_group",
        "member_profile",
        "member_eligibility",
        "resource",
        "resource_hold",
        "booking",
        "crossing_slot",
        "contract",
        "attendance_proof",
        "export_record",
        "audit_log"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "该聚合流上的单调版本号，从 1 开始；并发提交以版本号做乐观并发控制。"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "description": "事件载荷，字段约定见事件目录。"
    },
    "correlation_id": {
      "type": "string",
      "description": "同一业务过程（如一次分批调度、一次结算）的关联标识。"
    },
    "causation_id": {
      "type": "string",
      "description": "触发本事件的命令或上游事件标识。"
    },
    "actor": {
      "type": "object",
      "description": "实际操作人，如中外领队、调度员。",
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "description": "事件来源系统/组织。跨境资格等事件只接受有权来源。",
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": [
            "port_authority",
            "consular_authority",
            "domestic_organizer",
            "foreign_organizer",
            "travel_agent",
            "festival_dispatch",
            "system"
          ]
        }
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
